# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CLOUDFLARE_D1_ACCOUNT_ID: Optional Cloudflare Account ID for D1 Database REST API
CLOUDFLARE_D1_ACCOUNT_ID=

# CLOUDFLARE_D1_DATABASE_ID: Optional Cloudflare D1 Database ID (e.g., nou / noudb)
CLOUDFLARE_D1_DATABASE_ID=

# CLOUDFLARE_D1_API_TOKEN: Optional Cloudflare API Token for direct D1 REST API operations
CLOUDFLARE_D1_API_TOKEN=
